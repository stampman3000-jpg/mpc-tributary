{
  "name": "Tributary",
  "vendor": "johnny",
  "uid": "Trib",
  "version": 1200,
  "defines": { "HAS_DISPLAY_REV": 1, "HAS_SONG_POS": 1 },
  "targets": ["armv7", "aarch64"],
  "so": "tributary.so",
  "params": "params.json",
  "layout": "layout.conf",
  "art": "html",
  "build": {
    "root": "..",
    "sources": [
      "src/probe.c",
      "src/capture.c"
    ],
    "cflags": [
